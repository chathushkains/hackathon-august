# Environment Variables Template
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgres://medusa:medusa@localhost:5432/medusa

# Redis
REDIS_URL=redis://localhost:6379

# Medusa Configuration
MEDUSA_BASE_URL=http://localhost:9000
MEDUSA_ADMIN_TOKEN=your-admin-token-here
MEDUSA_ADMIN_CORS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MEDUSA_STORE_CORS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Security
JWT_SECRET=your-jwt-secret-here
COOKIE_SECRET=your-cookie-secret-here

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# AI Agent
OPENAI_API_KEY=your-openai-api-key-here

# Service URLs
ORCHESTRATOR_URL=http://localhost:4002
EVENT_SERVER_URL=http://localhost:4003
AI_AGENT_URL=http://localhost:4004

# Next.js Environment Variables (for apps)
NEXT_PUBLIC_MEDUSA_BASE_URL=http://localhost:9000
NEXT_PUBLIC_ORCHESTRATOR_URL=http://localhost:4002
NEXT_PUBLIC_EVENT_SERVER_URL=http://localhost:4003
NEXT_PUBLIC_AI_AGENT_URL=http://localhost:4004
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
